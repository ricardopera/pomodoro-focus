{
  "name": "pomodoro-focus",
  "version": "2.0.0",
  "description": "Aplicativo Pomodoro para Windows: bonito, sem distrações e com nome e descrição para cada sessão de foco",
  "main": "dist/main/index.cjs",
  "type": "module",
  "author": "@ricardopera",
  "license": "MIT",
  "keywords": [
    "pomodoro",
    "focus",
    "productivity",
    "electron",
    "timer",
    "windows"
  ],
  "scripts": {
    "dev": "npm run build:main && node scripts/dev.js",
    "build:main": "node scripts/build-main.js",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "build:prod": "npm run icons && npm run build",
    "icons": "node scripts/generate-icons.js",
    "preview": "vite preview",
    "dist": "npm run build:prod && electron-builder",
    "dist:win": "npm run build:prod && electron-builder --win",
    "dist:linux": "npm run build:prod && electron-builder --linux",
    "pack": "npm run build:prod && electron-builder --dir",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts --ext .ts,.tsx,.js",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\""
  },
  "build": {
    "appId": "com.ricardopera.pomodoro-focus",
    "productName": "Pomodoro Focus",
    "copyright": "Copyright © 2026 Ricardo Pera",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "public/icons/**/*",
      "index.html",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico",
      "publisherName": "Ricardo Pera",
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pomodoro Focus",
      "artifactName": "PomodoroFocus-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "PomodoroFocus-Portable-${version}.${ext}"
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "build",
      "category": "Utility",
      "maintainer": "Ricardo Pera",
      "synopsis": "Pomodoro timer sem distrações"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity"
    }
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.19",
    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.25.10",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "png-to-ico": "^3.0.1",
    "prettier": "^3.6.2",
    "sharp": "^0.34.4",
    "typescript": "^5.9.3",
    "vite": "^5.4.20",
    "vitest": "^1.6.1"
  }
}
